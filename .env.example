# Mystic — .env Vorlage (NUR Platzhalter, KEINE echten Tokens hier eintragen und committen!)
# Kopieren: cp .env.example .env  —  dann echte Werte NUR lokal in .env eintragen.
# .env steht in .gitignore und wird NIE gepusht.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
DISCORD_BOT_TOKEN=
# Optional:
# GITHUB_PERSONAL_ACCESS_TOKEN=  <- lieber NICHT hier, sondern per System-Keyring / hermes config / gh auth
